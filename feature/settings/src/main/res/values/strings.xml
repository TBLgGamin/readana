    <string name="feature_settings_library_folder_default">App storage (private)</string>
    <string name="feature_settings_library_folder_clear">Use app storage</string>
    <string name="feature_settings_library_folder_note">Books in app storage are deleted when Readana is uninstalled. Choosing a folder keeps new books outside the app; books already imported stay where they are.</string>
    <string name="feature_settings_section_sources">Book sources</string>
    <string name="feature_settings_annas_notice">Anna\'s Archive indexes shadow libraries. Downloading copyrighted works without permission is illegal in most countries; mirrors are also blocked by some ISPs. You are responsible for what you download.</string>
    <string name="feature_settings_annas_mirrors">Anna\'s Archive mirrors</string>
    <string name="feature_settings_annas_mirrors_help">One URL per line, tried in order. Leave empty for the built-in defaults.</string>
    <string name="feature_settings_annas_secret_key">Member secret key (optional)</string>
    <string name="feature_settings_annas_secret_key_help">Members skip the browser check and get fast downloads. Without a key, Readana answers the check itself and downloads at the free speed.</string>

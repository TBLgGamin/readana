root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# 120 keeps string-template heavy code (EPUB XML, SQL) readable; detekt matches this.
max_line_length = 120
# ktlint (via Spotless) reads these keys.
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-empty-first-line-in-class-body = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf

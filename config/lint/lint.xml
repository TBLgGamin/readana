<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint configuration shared by every module (see build-logic AndroidLint.kt).
  Warnings are treated as errors, so anything noisy-but-harmless is downgraded here
  with a reason. Prefer fixing over suppressing.
-->
<lint>
    <!-- Dependency freshness is Dependabot's job, not a build failure. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- API 37 (Android 17) is out but the Xiaomi Pad 8 runs Android 16; bump targetSdk deliberately. -->
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Single-language personal app. -->
    <issue id="MissingTranslation" severity="ignore" />
    <!-- Third-party lint jars built against older lint APIs shouldn't break the build. -->
    <issue id="ObsoleteLintCustomCheck" severity="ignore" />
    <!--
      AAPT requires adaptive-icon XML in the v26-qualified mipmap directory even when minSdk is
      newer. Lint's ObsoleteSdkInt folder check conflicts with the resource linker here, so keep
      the exception limited to the two launcher resources in this directory.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore regexp=".*mipmap-anydpi-v26.*" />
    </issue>
    <!--
      PDFBox pulls in BouncyCastle for encrypted PDFs. The permissive trust manager lint finds is
      inside that library's own bytecode; Readana never uses its TLS helpers (all networking goes
      through Ktor/OkHttp). Scoped to those jars so the check still fires on our code.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="bcpkix|bcprov|bcutil" />
    </issue>

    <!-- Keep these loud. -->
    <issue id="UnusedResources" severity="error" />
    <issue id="HardcodedText" severity="error" />
    <issue id="NewApi" severity="fatal" />
</lint>

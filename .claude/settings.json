{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(gradlew.bat *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(adb devices*)",
      "Bash(adb install*)",
      "Bash(adb shell am start*)",
      "Bash(adb logcat*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/session_start.py",
            "timeout": 30,
            "statusMessage": "Collecting repo state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/check_kotlin_file.py",
            "timeout": 20,
            "statusMessage": "Checking repo conventions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python scripts/hooks/guard_commit.py",
            "timeout": 40,
            "statusMessage": "Checking commit conventions"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/format_on_stop.py",
            "timeout": 600,
            "statusMessage": "Formatting repo (spotlessApply)"
          }
        ]
      }
    ]
  }
}
